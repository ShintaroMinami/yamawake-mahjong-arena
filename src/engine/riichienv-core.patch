+// ---------------------------------------------------------------------------
+// yamawake patch: incremental shanten (one tile added or removed).
+//
+// `calc_normal` hashes each suit separately and chains the four suit keys;
+// a hand that differs from a known one in a single tile differs in one suit.
+// `HandShanten` keeps a hand's four suit keys and its chiitoitsu / kokushi
+// tallies and gives the shanten with one tile added or removed by rehashing
+// that suit only. Values equal `calc_shanten_from_counts` of the changed
+// hand (tested in yamawake's `src/rust/eval/shanten.rs`).
+// ---------------------------------------------------------------------------
+
+/// yamawake patch: the key of suit `s` (0..3 manzu, pinzu, souzu; 3 honors).
+#[inline]
+fn suit_key(counts: &[u8; TILE_MAX], s: usize) -> u8 {
+    if s < 3 {
+        SHUPAI_KEYS[hash_shupai(&counts[s * 9..s * 9 + 9])]
+    } else {
+        ZIPAI_KEYS[hash_zipai(&counts[27..34])]
+    }
+}
+
+/// yamawake patch: regular-hand shanten from the four suit keys.
+#[inline]
+fn normal_from_keys(k: &[u8; 4], len_div3: usize) -> i8 {
+    let k1 = KEYS1[k[0] as usize * 126 + k[1] as usize] as usize;
+    let k2 = KEYS2[k1 * 126 + k[2] as usize] as usize;
+    (KEYS3[(k2 * 55 + k[3] as usize) * 5 + len_div3] as i8) - 1
+}
+
+#[inline]
+fn is_orphan(t: usize) -> bool {
+    t >= 27 || t % 9 == 0 || t % 9 == 8
+}
+
+/// yamawake patch: the forward pass of a suit's perfect hash, the sum of
+/// `table[j][n_j][c_j]` (`n_j`: tiles up to position `j`): the hash, and per
+/// position the sum before it and `n_j`.
+#[inline]
+fn forward_hash<const L: usize>(c: &[u8], table: &[[[u32; 5]; 15]; L], pre: &mut [u32], ns: &mut [u8]) -> usize {
+    let (mut prefix, mut n) = (0u32, 0usize);
+    for i in 0..L {
+        let ci = usize::from(c[i]);
+        pre[i] = prefix;
+        n += ci;
+        ns[i] = n as u8;
+        prefix += table[i][n][ci];
+    }
+    prefix as usize
+}
+
+/// yamawake patch: the perfect hash of suit `c` with one tile of position `i`
+/// added (`UP`) or removed, into `out[i]`, for every position `i` at once
+/// (only those that can change: fewer than 4 / at least 1 held). Such a change
+/// moves `n_j` by one for every `j` from `i` on, so the forward pass and one
+/// backward sum give all of them.
+#[inline]
+fn shifted_hashes<const L: usize, const UP: bool>(c: &[u8], table: &[[[u32; 5]; 15]; L], pre: &[u32], ns: &[u8], out: &mut [usize; L]) {
+    let mut suffix = 0u32;
+    for i in (0..L).rev() {
+        let (ci, ni) = (usize::from(c[i]), usize::from(ns[i]));
+        if UP {
+            if ci < 4 {
+                out[i] = (pre[i] + table[i][ni + 1][ci + 1] + suffix) as usize;
+            }
+            suffix += table[i][ni + 1][ci];
+        } else {
+            if ni == 0 {
+                break;
+            }
+            if ci > 0 {
+                out[i] = (pre[i] + table[i][ni - 1][ci - 1] + suffix) as usize;
+            }
+            suffix += table[i][ni - 1][ci];
+        }
+    }
+}
