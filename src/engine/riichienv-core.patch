+            let t = 27 + i;
+            let old = self.counts[t];
+            if old == 0 {
+                continue;
+            }
+            let normal = (KEYS3[(j2 * 55 + usize::from(ZIPAI_KEYS[hashes[i]])) * 5 + len] as i8) - 1;
+            if self.with_tallies(normal, t, old, false) == base {
