+// ---------------------------------------------------------------------------
+// yamawake patch: incremental shanten (one tile added or removed).
+//
+// `calc_normal` hashes each suit separately and chains the four suit keys;
+// a hand that differs from a known one in a single tile differs in one suit.
+// `HandShanten` keeps a hand's four suit keys and its chiitoitsu / kokushi
+// tallies and gives the shanten with one tile added or removed by rehashing
+// that suit only. Values equal `calc_shanten_from_counts` of the changed
+// hand (tested in yamawake's `src/rust/eval/shanten.rs`).
+// ---------------------------------------------------------------------------
+
+/// yamawake patch: the key of suit `s` (0..3 manzu, pinzu, souzu; 3 honors).
+#[inline]
+fn suit_key(counts: &[u8; TILE_MAX], s: usize) -> u8 {
+    if s < 3 {
+        SHUPAI_KEYS[hash_shupai(&counts[s * 9..s * 9 + 9])]
+    } else {
+        ZIPAI_KEYS[hash_zipai(&counts[27..34])]
+    }
+}
+
+/// yamawake patch: regular-hand shanten from the four suit keys.
+#[inline]
+fn normal_from_keys(k: &[u8; 4], len_div3: usize) -> i8 {
+    let k1 = KEYS1[k[0] as usize * 126 + k[1] as usize] as usize;
+    let k2 = KEYS2[k1 * 126 + k[2] as usize] as usize;
+    (KEYS3[(k2 * 55 + k[3] as usize) * 5 + len_div3] as i8) - 1
+}
+
+#[inline]
+fn is_orphan(t: usize) -> bool {
+    t >= 27 || t % 9 == 0 || t % 9 == 8
+}
+
+/// yamawake patch: one hand's suit keys and chiitoitsu / kokushi tallies,
+/// to read the shanten of the hand with one tile added or removed.
+#[derive(Clone)]
+pub struct HandShanten {
+    counts: [u8; TILE_MAX],
+    keys: [u8; 4],
+    /// Tiles held.
+    n: u8,
+    /// Tile types held, and held twice or more (chiitoitsu).
+    kinds: u8,
+    pairs: u8,
+    /// Terminal and honor types held, and held twice or more (kokushi).
+    orphan_kinds: u8,
+    orphan_pairs: u8,
+}
+
+impl HandShanten {
+    pub fn new(counts: &[u8; TILE_MAX]) -> Self {
+        let (mut n, mut kinds, mut pairs, mut orphan_kinds, mut orphan_pairs) = (0u8, 0u8, 0u8, 0u8, 0u8);
+        for (t, &c) in counts.iter().enumerate() {
+            n += c;
+            kinds += u8::from(c > 0);
+            pairs += u8::from(c >= 2);
+            if is_orphan(t) {
+                orphan_kinds += u8::from(c > 0);
+                orphan_pairs += u8::from(c >= 2);
+            }
+        }
+        let keys = [suit_key(counts, 0), suit_key(counts, 1), suit_key(counts, 2), suit_key(counts, 3)];
+        Self { counts: *counts, keys, n, kinds, pairs, orphan_kinds, orphan_pairs }
+    }
+
+    /// `calc_shanten_from_counts` from the parts (same as `calc_chitoi` and
+    /// `calc_kokushi` over the tallies).
+    #[inline]
+    fn combine(keys: &[u8; 4], n: u8, kinds: u8, pairs: u8, orphan_kinds: u8, orphan_pairs: u8) -> i8 {
+        let len_div3 = n / 3;
+        let s = normal_from_keys(keys, len_div3 as usize);
+        if s <= 0 || len_div3 < 4 {
+            return s;
+        }
+        let chitoi = 7 - pairs as i8 + 7u8.saturating_sub(kinds) as i8 - 1;
+        let s = s.min(chitoi);
+        if s > 0 {
+            s.min(14 - orphan_kinds as i8 - i8::from(orphan_pairs > 0) - 1)
+        } else {
+            s
+        }
+    }
+
+    /// Shanten of the hand.
+    pub fn shanten(&self) -> i8 {
+        Self::combine(&self.keys, self.n, self.kinds, self.pairs, self.orphan_kinds, self.orphan_pairs)
+    }
+
+    /// Shanten with one more tile of type `t` (held fewer than four times).
+    pub fn plus(&self, t: usize) -> i8 {
+        let old = self.counts[t];
+        debug_assert!(old < 4);
+        self.changed(t, old + 1, u8::from(old == 0), u8::from(old == 1), true)
+    }
+
+    /// Shanten with one tile of type `t` (held) taken out.
+    pub fn minus(&self, t: usize) -> i8 {
+        let old = self.counts[t];
+        debug_assert!(old > 0);
+        self.changed(t, old - 1, u8::from(old == 1), u8::from(old == 2), false)
+    }
+
+    /// The shanten with `counts[t]` set to `new` (one more or one fewer):
+    /// `dk`/`dp` are the kind and pair changes, added when `up`.
+    #[inline]
+    fn changed(&self, t: usize, new: u8, dk: u8, dp: u8, up: bool) -> i8 {
+        let mut c = self.counts;
+        c[t] = new;
+        let s = if t < 27 { t / 9 } else { 3 };
+        let mut keys = self.keys;
+        keys[s] = suit_key(&c, s);
+        let (dok, dop) = if is_orphan(t) { (dk, dp) } else { (0, 0) };
+        if up {
+            Self::combine(&keys, self.n + 1, self.kinds + dk, self.pairs + dp, self.orphan_kinds + dok, self.orphan_pairs + dop)
+        } else {
+            Self::combine(&keys, self.n - 1, self.kinds - dk, self.pairs - dp, self.orphan_kinds - dok, self.orphan_pairs - dop)
+        }
+    }
 }
