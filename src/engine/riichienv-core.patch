+        let len = usize::from(n / 3);
+        let k = &self.keys;
+        let j1 = KEYS1[usize::from(k[0]) * 126 + usize::from(k[1])] as usize;
+        let j2 = KEYS2[j1 * 126 + usize::from(k[2])] as usize;
